{
  "about": "The hooks key of specs/claude-code/settings.json before the manifests existed (2026-10-13). The oracle: what seed_hooks.py renders for claude-code must equal this in effect, as the set of (event, matcher set, command, timeout).",
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/deny-bash-file-writes.sh", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/guard-rm.sh", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/guard-private.sh", "timeout": 10}]},
      {"matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Update|Create|Bash|Grep|Glob", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/block-env-files.sh"}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/ask-clipboard-reads.sh", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/deny_debugger_attach.py", "timeout": 5}]},
      {"matcher": "AskUserQuestion|ExitPlanMode", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/peer_turn_no_dialog.py", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/ask-before-claude-folder-edits.sh"}]},
      {"matcher": "Read", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/read-size-advisory.sh", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/memory-routing.sh", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-meta-commentary.sh", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/reject_words.py", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/reject_invisibles.py", "timeout": 10}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/reject_identifiers.py", "timeout": 10}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/reject_published_copy_edits.py", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/reject_bad_commit_message.py", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/guard_git_bypass.py", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/warn_cross_repo_git.py", "timeout": 10}]},
      {"matcher": "Bash|Agent|Workflow|mcp__.*", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/memory_pressure_gate.py", "timeout": 10}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}]}
    ],
    "PostToolBatch": [
      {"hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}
      ]}
    ],
    "PostToolUse": [
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/memory_lint.py", "timeout": 10}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-meta-commentary-check.sh", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/skill_description_lint.py", "timeout": 10}]}
    ],
    "SessionStart": [
      {"matcher": "startup|resume", "hooks": [
        {"type": "command", "command": "bash ~/.claude/hooks/agent-mail-check.sh", "timeout": 10},
        {"type": "command", "command": "python3 ~/.claude/hooks/cmon_nudge.py", "timeout": 5},
        {"type": "command", "command": "python3 ~/.claude/hooks/claude_mem_health.py", "timeout": 15}
      ]},
      {"matcher": "startup", "hooks": [{"type": "command", "command": "python3 ~/.claude/hooks/harness_version_check.py", "timeout": 15}]},
      {"matcher": "startup|resume|clear|compact", "hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/daemon_restart_storm.py", "timeout": 10},
        {"type": "command", "command": "python3 ~/.claude/hooks/memory_pressure_gate.py", "timeout": 10},
        {"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10}
      ]}
    ],
    "UserPromptSubmit": [
      {"hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/daemon_restart_storm.py", "timeout": 10},
        {"type": "command", "command": "python3 ~/.claude/hooks/memory_pressure_gate.py", "timeout": 10},
        {"type": "command", "command": "python3 ~/.claude/hooks/warn_foreign_edits.py", "timeout": 10},
        {"type": "command", "command": "python3 ~/.claude/hooks/cmon_nudge.py", "timeout": 5}
      ]}
    ]
  }
}
