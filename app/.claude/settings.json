{
  "permissions": {
    "allow": [
      "Edit(./vault/_RESEARCH/**)",
      "Edit(./vault/LEARNING/**)",
      "Edit(./vault/PROJECTS/**)",
      "Edit(./vault/__archive/**)",
      "Bash(agents seat:*)",
      "Bash(uv run agents seat:*)",
      "Bash(agents search:*)",
      "Bash(uv run agents search:*)",
      "Bash(agents config get:*)",
      "Bash(agents config set:*)",
      "Bash(uv run agents config get:*)",
      "Bash(uv run agents config set:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/config)",
      "Read(**/.gnupg/**)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Read(**/.config/gh/hosts.yml)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.claude.json)",
      "Read(**/.claude/.credentials.json)",
      "Read(**/.codex/auth.json)",
      "Read(**/.copilot/**)",
      "Read(**/.cursor/mcp.json)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Edit(./vault/KNOWLEDGE-BASE/**)"
    ]
  }
}
