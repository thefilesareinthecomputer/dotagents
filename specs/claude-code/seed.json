{
  "schema": 1,
  "harness": "claude-code",
  "rows": [
    {"element": "Skills", "also": ["Subagents", "Commands"], "shape": "LINK", "path": "~/.claude/skills/",
     "note": "sync-skills.sh plants skills/, agents/ and commands/ in one run"},
    {"element": "Rules", "shape": "POINTER", "path": "~/.claude/CLAUDE.md", "source": "specs/claude-code/CLAUDE.md.example"},
    {"element": "Permissions and settings", "shape": "FRAGMENT", "path": "~/.claude/settings.json", "format": "json",
     "source": "specs/claude-code/settings.json",
     "keys": ["permissions", "env", "statusLine.type", "statusLine.command", "subagentStatusLine.type",
              "subagentStatusLine.command", "enabledPlugins", "extraKnownMarketplaces",
              "disableRemoteControl", "enableArtifact", "deniedMcpServers", "cleanupPeriodDays",
              "attribution", "autoUpdatesChannel"]},
    {"element": "Hooks", "shape": "COPY", "path": "~/.claude/hooks/", "via": "seed_hooks"},
    {"element": "Status lines", "shape": "COPY", "path": "~/.claude/statusline.sh", "source": "specs/claude-code/statusline.sh"},
    {"element": "Status lines", "shape": "COPY", "path": "~/.claude/subagent-statusline.sh", "source": "specs/claude-code/subagent-statusline.sh"},
    {"element": "Keybindings", "shape": "COPY", "path": "~/.claude/keybindings.json", "source": "specs/claude-code/keybindings.json"},
    {"element": "claude-mem settings", "shape": "FRAGMENT", "path": "~/.claude-mem/settings.json", "format": "json-flat",
     "if_present": true,
     "keys": {"CLAUDE_MEM_RUNTIME": "worker",
              "CLAUDE_MEM_PROVIDER": "claude",
              "CLAUDE_MEM_CLAUDE_AUTH_METHOD": "subscription",
              "CLAUDE_MEM_GEMINI_API_KEY": "",
              "CLAUDE_MEM_OPENROUTER_API_KEY": "",
              "CLAUDE_MEM_SKIP_TOOLS": "ListMcpResourcesTool,SlashCommand,Skill,TodoWrite,AskUserQuestion,Read,Glob,Grep,ToolSearch,WebSearch,WebFetch,CronList,CronCreate,CronDelete,ScheduleWakeup,TaskList,TaskGet,TaskOutput,mcp__plugin_claude-mem_mcp-search__,mcp__Claude_Preview__preview_screenshot,mcp__Claude_Preview__preview_snapshot,mcp__Claude_Preview__preview_logs,mcp__Claude_Preview__preview_network,mcp__Claude_in_Chrome__read_page,mcp__Claude_in_Chrome__get_page_text,mcp__Claude_in_Chrome__read_console_messages,mcp__Claude_in_Chrome__read_network_requests",
              "CLAUDE_MEM_MODEL": "claude-haiku-5-5",
              "CLAUDE_MEM_TIER_FAST_MODEL": "claude-haiku-5-5",
              "CLAUDE_MEM_TIER_SIMPLE_MODEL": "claude-haiku-5-5",
              "CLAUDE_MEM_TIER_SUMMARY_MODEL": "claude-haiku-5-5",
              "CLAUDE_MEM_TIER_SMART_MODEL": "claude-sonnet-5-5"}},
    {"element": "claude-mem telemetry", "shape": "FRAGMENT", "path": "~/.claude-mem/telemetry.json", "format": "json-flat",
     "if_present": true, "keys": {"enabled": false}},
    {"element": "claude-mem uvx wrapper", "shape": "COPY", "path": "~/.claude-mem/bin/uvx",
     "source": "specs/claude-code/claude-mem/uvx", "mode": "0755"}
  ]
}
