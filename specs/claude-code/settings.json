{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(rtk --version)",
      "Bash(rtk gain)",
      "Bash(rtk config)",
      "Bash(rtk smart:*)",
      "Bash(rtk deps:*)",
      "Bash(brain search:*)",
      "Bash(brain config get:*)",
      "WebSearch",
      "Read(/plugins/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Read(~/.claude/private/**)",
      "Edit(~/.claude/private/**)",
      "Grep(~/.claude/private/**)",
      "Read(/private/**)",
      "Edit(/private/**)",
      "Edit(~/.claude/state/**)",
      "Edit(/state/**)",
      "mcp__playwright__browser_run_code_unsafe"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "rtk hook claude" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/deny-bash-file-writes.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/guard-rm.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/guard-private.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Update|Create|Bash|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/block-env-files.sh" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/ask-before-claude-folder-edits.sh" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/read-size-advisory.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/memory-routing.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-meta-commentary.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/reject_invisibles.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/reject_identifiers.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/reject_published_copy_edits.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/reject_bad_commit_message.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|Agent|Workflow|mcp__.*",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/memory_pressure_gate.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/scan_identifiers_on_stop.sh", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/memory_lint.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-meta-commentary-check.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/cover-me-nudge.sh", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/agent-mail-check.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/daemon_restart_storm.py", "timeout": 10 },
          { "type": "command", "command": "python3 ~/.claude/hooks/memory_pressure_gate.py", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/daemon_restart_storm.py", "timeout": 10 },
          { "type": "command", "command": "python3 ~/.claude/hooks/memory_pressure_gate.py", "timeout": 10 }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "agent-skills@addy-agent-skills": true,
    "skill-creator@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "autoUpdatesChannel": "latest"
}
