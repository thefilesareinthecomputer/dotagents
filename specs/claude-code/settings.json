{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_MEM_TELEMETRY": "false",
    "CLAUDE_MEM_CHROMA_UVX_PATH": "~/.claude-mem/bin"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "WebSearch",
      "Read(/plugins/**)"
    ],
    "ask": [
      "Bash(*codex_task.py*run*)",
      "Bash(*task.py*codex*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Read(~/.claude/private/**)",
      "Edit(~/.claude/private/**)",
      "Grep(~/.claude/private/**)",
      "Read(/private/**)",
      "Edit(/private/**)",
      "Edit(~/.claude/state/**)",
      "Edit(/state/**)",
      "Edit(**/.claude-mem/bin/**)",
      "mcp__playwright__browser_run_code_unsafe"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deny-bash-file-writes.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-rm.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-private.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/ask-clipboard-reads.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/reject_bad_commit_message.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard_git_bypass.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_cross_repo_git.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-env-files.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/reject_words.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/reject_invisibles.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/reject_identifiers.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/reject_published_copy_edits.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-meta-commentary.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/ask-before-claude-folder-edits.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/memory-routing.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Workflow|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_pressure_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/read-size-advisory.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_pressure_gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/daemon_restart_storm.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-mail-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude_mem_health.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmon_nudge.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/harness_version_check.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_pressure_gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/daemon_restart_storm.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmon_nudge.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/voice_reply.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/skill_description_lint.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-meta-commentary-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_lint.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Update|Create|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/warn_foreign_edits.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/voice_reply.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Drive"
    }
  ],
  "cleanupPeriodDays": 3650,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "agent-skills@addy-agent-skills": true,
    "skill-creator@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "autoUpdatesChannel": "latest"
}
