# Canonical secret-exclusion list, referenced by AGENTS.md.
# Copy into a repo's .gitignore (or .cursorignore / .aiexclude / .geminiignore /
# .gooseignore). Ignore files are defense-in-depth only - the hard control is the
# agent's own permission/deny system.

# Env files (allow committed *.example / *.sample / *.template)
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# Private keys and certificates
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
id_rsa*
id_ed25519*
id_dsa*
id_ecdsa*

# Cloud / service-account credentials
credentials.json
service-account*.json
*-service-account*.json
gcp-*.json
aws-credentials*
.aws/credentials

# Tokens and auth artifacts
*.jwt
*.token
*_token.txt
.npmrc
.pypirc
.netrc

# Infra state that embeds secrets
*.tfstate
*.tfstate.*
secrets.json
secrets.yml
secrets.yaml
